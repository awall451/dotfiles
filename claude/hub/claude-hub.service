[Unit]
Description=Claude Code Remote Control hub (background session in ~) + restore of background sessions
After=network-online.target claude-daemon.service
Wants=network-online.target

# hub.sh must talk to the supervisor in claude-daemon.service, never start its own.
Requires=claude-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.config/claude-hub/hub.sh
ExecStop=%h/.config/claude-hub/hub.sh snapshot

[Install]
WantedBy=default.target
