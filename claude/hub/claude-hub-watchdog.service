[Unit]
Description=Ensure the Claude Code Remote Control hub session is running
After=claude-hub.service claude-daemon.service

# hub.sh must talk to the supervisor in claude-daemon.service, never start its own.
Requires=claude-daemon.service

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.config/claude-hub/hub.sh ensure
